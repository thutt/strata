# Strata C style.  Apply with clang-format; see docs/STYLE.txt.
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 80
ContinuationIndentWidth: 4

# Return type (with any '*') on its own line; function name on the next.
BreakAfterReturnType: All
PointerAlignment: Right

# Parameters: fill to column 80, then continue aligned under the first.
AlignAfterOpenBracket: Align
BinPackParameters: true
BinPackArguments: true

# '&&' and '||' end a line; they never begin one.
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: false

# One statement per line, braces always.
InsertBraces: true
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortEnumsOnASingleLine: false
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: Never
  AfterEnum: false
  AfterStruct: false
  AfterUnion: false
  BeforeElse: false
  SplitEmptyFunction: false

IndentCaseLabels: true
SortIncludes: Never
ReflowComments: true
MaxEmptyLinesToKeep: 2
SpaceAfterCStyleCast: true
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignTrailingComments: false
