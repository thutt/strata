# strata-build builds Strata.  All output goes into the build directory.
#
# First choose a build directory, once per shell:
#
#     source scripts/setup [-b debug|release|asan] /tmp/strata
#
# Then run one of these commands:
#
#     strata-build           Build everything (the same as 'all').  The
#                            install tarball is not made here.
#     strata-build help      List the valid targets.
#     strata-build term      Build only the terminal version.
#     strata-build x11       Build only the X11 version.
#     strata-build test      Build, then run the unit tests.
#     strata-build smoke     Run the terminal smoke tests in parallel
#                            (SMOKE_JOBS=n; 1 is serial).
#     strata-build smoke-quick  The same, every script for 60 seconds only.
#     strata-build verify    Run every test suite, then check that the
#                            source tree was not modified.
#     strata-build check-tools [--build] [--tests] [--run] [--quiet]
#                            Report which programs, headers and libraries
#                            that building, testing and running need are
#                            present, and the package of each missing one;
#                            installs nothing.  It needs no build directory.
#     strata-build clean     Delete the build products.
#     strata-build install   Make the install tarball in the build directory
#                            (see install-tarball below); it installs
#                            nothing.  To install from a build directory
#                            run scripts/strata-install --build-dir DIR
#                            [OPTIONS] (never part of 'all').
#                            'strata-build uninstall [--prefix DIR]'
#                            removes an install again.
#     strata-build release DIR
#                            Make the release directory DIR for delivery:
#                            the install script and the directory payload
#                            with the files that it installs.  The release
#                            holds no build script and no source.
#     strata-build install-tarball
#                            The same as 'strata-build install': make the
#                            install tarball in the build directory
#                            (a build artifact, never in the source tree),
#                            only when asked: strata-NAME.tar.xz and
#                            strata-NAME.tar.xz.sha256, where NAME is the
#                            version of the build (and the build type when
#                            it is not release).  The programs must be built
#                            first; no other target makes the tarball.  It is a
#                            fatal error to make it without every manual and
#                            the PDF file of every manual: run
#                            'strata-build manual' first.
#     strata-build manual    Make the manuals and their PDF files in the
#                            build directory (manual/doc and manual/pdf
#                            below it), with manual/build.sh; it needs LaTeX
#                            and the programs built.  It writes nothing into
#                            the source tree.  Never part of 'all'.
#
# Every other argument is handed to make as a target name, so 'strata-build
# help' always shows the current list.  The options -j N, -jN and --jobs=N
# before the command give the number of jobs.

set -euo pipefail

# Stop with a message.
function die
{
    echo "strata-build: ${*}" >&2
    exit 1
}

# The check of the tools needs no build directory.
if [ "${1:-}" = "check-tools" ]; then
    shift
    exec "$(dirname "${BASH_SOURCE[0]}")/check-tools" "${@}"
fi

# The setup script must have been sourced first.
if [ -z "${STRATA_BUILD_DIR:-}" ]; then
    die "run 'source scripts/setup /tmp/strata' first."
fi

# The environment of an older setup script has no build root, and its
# build directory does not end in the build type.
if [ "${STRATA_BUILD_DIR}" != \
     "${STRATA_BUILD_ROOT:-}/${STRATA_BUILD_TYPE:-debug}" ]; then
    die "the environment is out of date; source scripts/setup again."
fi

if [ -z "${STRATA_DIR:-}" ] || [ -z "${STRATA_ROOT:-}" ]; then
    die "run 'source scripts/setup /tmp/strata' first."
fi

# Refuse to build inside the source tree, even if the variables were
# set by hand instead of by the setup script.
build=$(realpath -m -- "${STRATA_BUILD_DIR}")

case "${build}/" in
    "${STRATA_ROOT}"/*)
        die "the build directory ${build} is inside the source tree."
        ;;
esac

case "${STRATA_ROOT}/" in
    "${build}"/*)
        die "the build directory ${build} contains the source tree."
        ;;
esac

# Build with one job per processor.
jobs=$(nproc 2>/dev/null || echo 2)

# Leading options: -j N, -jN and --jobs=N give the number of jobs.  They are
# taken here, so that the command that follows them is found: the line
# 'strata-build -j 32 install' is the command install.
while [ ${#} -gt 0 ]; do
    case "${1}" in
        -j)
            [ ${#} -ge 2 ] || die "-j needs a number of jobs."
            jobs="${2}"
            shift 2
            ;;
        -j[0-9]*)
            jobs="${1#-j}"
            shift
            ;;
        --jobs=*)
            jobs="${1#--jobs=}"
            shift
            ;;
        *)
            break
            ;;
    esac
done

case "${jobs}" in
    "" | *[!0-9]*)
        die "the number of jobs must be a number, not '${jobs}'."
        ;;
esac

# With no arguments, build the default target.
if [ ${#} -eq 0 ]; then
    set -- all
fi

# The install and the uninstall are done by a script of their own.
case "${1}" in
    install)
        shift
        if [ ${#} -ne 0 ]; then
            die "install takes no options: it makes the install tarball in" \
                "the build directory.  To install from the build directory" \
                "run: scripts/strata-install --build-dir DIR [OPTIONS]."
        fi
        exec "${STRATA_ROOT}/scripts/strata-install-tarball" "${build}" \
            "${STRATA_BUILD_TYPE:-debug}"
        ;;
    uninstall)
        shift
        exec "${STRATA_ROOT}/scripts/strata-install" --uninstall "${@}"
        ;;
    release)
        shift
        exec "${STRATA_ROOT}/scripts/strata-install" \
            --build-dir "${build}" --make-release "${@}"
        ;;
    install-tarball)
        exec "${STRATA_ROOT}/scripts/strata-install-tarball" "${build}" \
            "${STRATA_BUILD_TYPE:-debug}"
        ;;
    manual)
        shift
        if [ ${#} -ne 0 ]; then
            die "manual takes no arguments: it makes the manuals and their" \
                "PDF files in ${build}/manual."
        fi
        echo "strata-build: making the manuals and their PDF files in" \
             "${build}/manual"
        exec env -u PDFDIR -u MANUAL_OUT XBIN="${build}/x11" \
            STRATA_BUILD_DIR="${build}" "${STRATA_ROOT}/manual/build.sh" all
        ;;
esac

if [ "${1}" != "help" ]; then
    echo "strata-build: ${STRATA_BUILD_TYPE:-debug} build in ${build}"
fi

make -C "${STRATA_DIR}" -j"${jobs}" "${@}"

# Tell the user where the programs are after a build.
case "${1}" in
    all)
        echo "strata-build: done."
        echo "  Terminal: ${build}/term/stred and ${build}/term/str"
        echo "  X11:      ${build}/x11/stred and ${build}/x11/str"

        if [ -x "${build}/term/dviview" ] && [ -x "${build}/x11/dviview" ]; then
            echo "  Viewer:   ${build}/term/dviview and ${build}/x11/dviview"
        else
            echo "strata-build: the Viewer dviview was not built in" \
                 "${build}/term and ${build}/x11."
        fi
        ;;
esac
