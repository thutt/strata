#!/bin/bash
# Copyright (c) 2026 Logic Magicians Software
#
# Makes a release: the tag vX.Y.0 on a commit, and the install tarball built
# from that tag (see docs/INSTALL-POLICY.txt, section "Making a release"):
#
#     strata-release VERSION [--commit REV] [--jobs N] [--dry-run] [--help]
#     strata-release VERSION --rebuild [--jobs N] [--dry-run]
#
# VERSION is the release number X.Y.0, for example 1.0.0 or 1.1.0.  The
# release is the first number.  The tool is a tool of the developers: it is
# never shipped, and it never pushes, signs or contacts a network.  It makes
# the manuals and their PDF files too (they are in every release), so it
# needs LaTeX: this is checked before anything is changed.  The build root
# comes from the environment (STRATA_BUILD_ROOT, set by sourcing
# scripts/setup), and the tarball and its checksum file are made in its
# directory release; there is no option to put them anywhere else.
#
# With --rebuild the tag vVERSION must exist already (an annotated tag): no
# tag is made, moved or removed, and the tarball and its checksum file are
# made again from the tree of that tag, on this machine.  The bytes of such a
# tarball differ from those of the release made on another machine, because
# the programs and the PDF files are made by the tools of the machine; the
# checksum that counts is the one of the file that was published.
#
set -o pipefail;
set -o nounset;
set -o errexit;

script_dir="$(cd "$(dirname "${0}")" && pwd -P)";
project_dir="$(dirname "${script_dir}")";

version="";
commit="HEAD";
commit_given="no";
rebuild="no";
build_root="${STRATA_BUILD_ROOT:-}";
jobs="$(nproc 2>/dev/null || echo 2)";
dry_run="no";

# These record what the tool has made, so that a failure removes only that.
tag_made="no";
worktree="";
worktree_made="no";
build_made="no";
results_started="no";
finished="no";


# Prints the usage on the standard output.
function usage
{
    cat <<EOF
usage: strata-release VERSION [OPTIONS]

Makes the annotated tag vVERSION on a commit, builds that tag in a scratch
worktree, makes the manuals and their PDF files (it needs LaTeX), and makes
the install tarball strata-VERSION.tar.xz with its checksum file
strata-VERSION.tar.xz.sha256.  A tarball without the manuals is a fatal
error.

  VERSION             the release number X.Y.0, for example 1.0.0 or 1.1.0.
  --commit REV        the commit to tag (default HEAD).
  --rebuild           make the tarball again from the EXISTING annotated tag
                      vVERSION: no tag is made, moved or removed, and the
                      commit is the one of the tag (--commit is an error
                      with it).  The bytes of the tarball differ from those
                      of a release made on another machine, because the
                      programs and the PDF files are made by the tools of
                      this machine; the checksum that counts is the one of
                      the file that was published.

The build root is the one of the environment: source scripts/setup first (for
example: source scripts/setup -b release /tmp/strata).  The tarball and its
checksum file are made in the directory release below it, and nowhere else.
  --jobs N            the number of jobs of the build (default: processors).
  --dry-run           check everything, print what would be done, change
                      nothing.
  --help              print this text.

Nothing is pushed, signed or sent.  An existing tag is never changed or
removed.
EOF
}


# Stops with a message on the error output.
function die
{
    echo "strata-release: ${*}" >&2;
    exit 1;
}


# Removes what the tool has made when it does not finish.  It is run when
# the tool exits, and it removes only what the tool made itself.
function cleanup
{
    local removed="";

    if [ "${finished}" = "yes" ]; then
        return 0;
    fi

    if [ "${worktree_made}" = "yes" ]; then
        git -C "${project_dir}" worktree remove --force "${worktree}" \
            >/dev/null 2>&1 || rm -rf -- "${worktree}";
        git -C "${project_dir}" worktree prune >/dev/null 2>&1 || true;
        removed="the scratch worktree";
    fi

    if [ "${tag_made}" = "yes" ]; then
        git -C "${project_dir}" tag -d "v${version}" >/dev/null 2>&1 || true;
        removed="the tag v${version}${removed:+ and }${removed}";
    fi

    if [ "${results_started}" = "yes" ]; then
        rm -f -- "${build_root}/release/strata-${version}.tar.xz" \
              "${build_root}/release/strata-${version}.tar.xz.sha256";
    fi

    if [ "${build_made}" = "yes" ]; then
        rm -rf -- "${build_root}";
    fi

    if [ -n "${removed}" ]; then
        echo "strata-release: failed: removed ${removed}." >&2;
    fi
}

trap cleanup EXIT;
trap 'exit 130' INT TERM;


# Refuses because the tag exists, as the first refusal of the tool.
function refuse_tag_exists
{
    echo "strata-release: the tag v${version} exists already: nothing was" \
         "changed" >&2;
    echo "if it was not pushed and the release is to be made again, delete" \
         "it with git tag -d v${version}" >&2;
    exit 1;
}


# Reads the command line.
while [ "${#}" -gt 0 ]; do
    case "${1}" in
        --help | -h)
            usage;
            exit 0;
            ;;
        --dry-run)
            dry_run="yes";
            shift;
            ;;
        --rebuild)
            rebuild="yes";
            shift;
            ;;
        --commit | --jobs)
            [ "${#}" -ge 2 ] || die "${1} needs a value.";
            case "${1}" in
                --commit)
                    commit="${2}";
                    commit_given="yes";
                    ;;
                --jobs)
                    jobs="${2}";
                    ;;
            esac
            shift 2;
            ;;
        --commit=* | --jobs=*)
            case "${1}" in
                --commit=*)
                    commit="${1#--commit=}";
                    commit_given="yes";
                    ;;
                --jobs=*)
                    jobs="${1#--jobs=}";
                    ;;
            esac
            shift;
            ;;
        -*)
            die "unknown option: ${1} (strata-release --help lists them).";
            ;;
        *)
            [ -z "${version}" ] ||
                die "more than one version: ${version} ${1}.";
            version="${1}";
            shift;
            ;;
    esac
done

[ -n "${version}" ] || die "no version given.  Example: strata-release 1.0.0";

# Only a tag vX.Y.0 is read as a release by scripts/strata-version, so only
# a version X.Y.0 is made.
if ! [[ "${version}" =~ ^[0-9]+\.[0-9]+\.0$ ]]; then
    die "the version must be X.Y.0, with digits for X and Y, for example" \
        "1.0.0 or 1.1.0 (scripts/strata-version reads only a tag named" \
        "vX.Y.0 as a release): not '${version}'.";
fi

if [ "${rebuild}" = "yes" ] && [ "${commit_given}" = "yes" ]; then
    die "--commit cannot be used with --rebuild: the tag v${version} decides" \
        "the commit.";
fi

case "${jobs}" in
    "" | *[!0-9]* | 0)
        die "the number of jobs must be a positive number, not '${jobs}'.";
        ;;
esac

major="${version%%.*}";

# The build root is the one of the environment, and there is no other way to
# name it: the tarball and its checksum file are made in its directory release.
if [ -z "${build_root}" ]; then
    die "STRATA_BUILD_ROOT is not set: run 'source scripts/setup -b release" \
        "DIR' first, for the build root DIR of the environment: nothing was" \
        "changed.";
fi

for tool in git tar xz sha256sum; do
    command -v "${tool}" >/dev/null 2>&1 || die "${tool} is not installed.";
done

# The tool runs in a git repository whose top is the project directory.
top="$(git -C "${project_dir}" rev-parse --show-toplevel 2>/dev/null)" ||
    die "${project_dir} is not in a git repository.";
[ "$(cd "${top}" && pwd -P)" = "${project_dir}" ] ||
    die "${project_dir} is only a part of the repository at ${top}.";

# The manuals and their PDF files are made with LaTeX, and a release without
# them is a fatal error: the tools that build the programs and print with them
# must be there, and this is checked before anything is changed.
check_tools="${project_dir}/scripts/check-tools";
[ -x "${check_tools}" ] ||
    die "${check_tools} is not there: the tools of the manual cannot be" \
        "checked.";

if ! tools_report="$("${check_tools}" --build --run --quiet 2>&1)"; then
    echo "${tools_report}" >&2;
    die "the tools that make the manuals and their PDF files are missing" \
        "(see above): nothing was changed.";
fi

# The first check of all: the tag.  A tag of any kind counts.  With --rebuild
# the tag must exist, as an annotated tag of a commit, and it is never
# changed.
tag_object="";

if [ "${rebuild}" = "yes" ]; then
    tag_object="$(git -C "${project_dir}" rev-parse -q --verify \
                      "refs/tags/v${version}" 2>/dev/null)" ||
        die "the tag v${version} does not exist: --rebuild makes the" \
            "tarball again from an existing tag (nothing was changed).";
    [ "$(git -C "${project_dir}" cat-file -t "${tag_object}")" = "tag" ] ||
        die "the tag v${version} is not an annotated tag: --rebuild needs" \
            "the annotated tag that strata-release made (nothing was" \
            "changed).";
    commit="v${version}";
else
    if git -C "${project_dir}" rev-parse -q --verify \
           "refs/tags/v${version}" >/dev/null 2>&1; then
        refuse_tag_exists;
    fi

    # A remote that has the tag counts too.  This is the one place where the
    # tool asks another repository, and only when a remote is configured.
    for remote in $(git -C "${project_dir}" remote); do
        if remote_tags="$(git -C "${project_dir}" ls-remote --tags \
                              "${remote}" "refs/tags/v${version}" \
                              2>/dev/null)"; then
            if [ -n "${remote_tags}" ]; then
                echo "strata-release: the remote ${remote} has the tag" \
                     "v${version}: nothing was changed" >&2;
                exit 1;
            fi
        else
            echo "strata-release: the remote ${remote} could not be asked" \
                 "about the tag v${version}; the check was made without" \
                 "it." >&2;
        fi
    done
fi

rev="$(git -C "${project_dir}" rev-parse -q --verify \
           "${commit}^{commit}" 2>/dev/null)" ||
    die "there is no commit '${commit}'.";

if [ "${rebuild}" = "no" ]; then
    # A commit is one release only: scripts/strata-version takes the version
    # of a checkout from the release tag on it, so a second release tag would
    # be built under the name of the first.
    other_tag="$(git -C "${project_dir}" tag --points-at "${rev}" |
                 grep -E '^v[0-9]+\.[0-9]+\.0$' | head -n 1)" || other_tag="";
    if [ -n "${other_tag}" ]; then
        die "the commit ${rev} has the release tag ${other_tag} already: a" \
            "commit is one release only.";
    fi

    # Untracked files do not count; a changed or staged tracked file does.
    if [ -n "$(git -C "${project_dir}" status --porcelain \
                   --untracked-files=no)" ]; then
        die "a tracked file is modified or staged: commit or restore it" \
            "first, so that the release holds what is committed.";
    fi
fi

worktree="${project_dir}/.claude/worktrees/release-${version}";
[ ! -e "${worktree}" ] ||
    die "the scratch worktree ${worktree} exists: remove it first.";

build_root="$(realpath -m -- "${build_root}")";

case "${build_root}/" in
    "${project_dir}"/*)
        die "the build directory ${build_root} is inside the source tree.";
        ;;
esac

case "${project_dir}/" in
    "${build_root}"/*)
        die "the build directory ${build_root} contains the source tree.";
        ;;
esac

# The tarball of this release is not made over another one.
for existing in "${build_root}/release/strata-${version}.tar.xz" \
                "${build_root}/release/strata-${version}.tar.xz.sha256"; do
    [ ! -e "${existing}" ] ||
        die "${existing} exists already: remove it first (nothing was" \
            "changed).";
done

subject="$(git -C "${project_dir}" log -1 --format=%s "${rev}")";
echo "commit: ${rev}";
echo "        ${subject}";
if [ "${rebuild}" = "yes" ]; then
    echo "tag:    v${version} (existing tag, not changed)";
else
    echo "tag:    v${version} (Strata ${version} (release ${major}))";
fi

echo "build:  ${build_root}/release";

if [ "${dry_run}" = "yes" ]; then
    echo "strata-release: dry run: nothing was changed.";
    exit 0;
fi

# The tag, made without -f, so that git refuses a tag that appeared since the
# check above.  With --rebuild the tag exists and nothing is made.
if [ "${rebuild}" = "no" ]; then
    if ! git -C "${project_dir}" tag -a "v${version}" \
             -m "Strata ${version} (release ${major})" "${rev}" 2>/dev/null;
    then
        refuse_tag_exists;
    fi

    tag_made="yes";
fi

mkdir -p -- "${project_dir}/.claude/worktrees";
git -C "${project_dir}" worktree add --detach -q "${worktree}" \
    "v${version}" >/dev/null 2>&1 || die "the scratch worktree failed.";
worktree_made="yes";

if [ ! -e "${build_root}" ]; then
    build_made="yes";
fi

mkdir -p -- "${build_root}";
results_started="yes";

echo "strata-release: building v${version} in ${worktree} ...";

# The build is done by the scripts of the tagged checkout.
if ! ( cd "${worktree}" &&
       set +o nounset &&
       source scripts/setup -b release "${build_root}" >/dev/null &&
       ./scripts/strata-build -j "${jobs}" &&
       ./scripts/strata-build -j "${jobs}" manual &&
       ./scripts/strata-build -j "${jobs}" install ); then
    die "the build, the manuals or the tarball failed.";
fi

built="${build_root}/release";
name="strata-${version}";
tarball="${built}/${name}.tar.xz";
sumfile="${tarball}.sha256";

# The version of the tagged checkout is the name of the tarball.
if [ -r "${built}/version" ]; then
    built_version="$(head -n 1 "${built}/version")";
else
    built_version="";
fi

if [ "${built_version}" != "${version}" ]; then
    die "the version of the tagged checkout is '${built_version}', not" \
        "'${version}': the tarball would have another name.";
fi

[ -f "${tarball}" ] || die "the tarball ${tarball} was not made.";
[ -f "${sumfile}" ] || die "the checksum file ${sumfile} was not made.";

( cd "${built}" && sha256sum -c --status "${name}.tar.xz.sha256" ) ||
    die "the checksum of ${tarball} does not match its file.";

tops="$(tar -tJf "${tarball}" | awk -F/ '{ print $1 }' | sort -u)";
[ "${tops}" = "${name}" ] ||
    die "the tarball must hold the one directory ${name}, not: ${tops}.";

pdf_list="$(tar -tJf "${tarball}" |
            grep -E "^${name}/payload/share/strata/pdf/.+\.pdf$" |
            sed -e 's#.*/##')" || pdf_list="";
[ -n "${pdf_list}" ] ||
    die "the tarball holds no PDF file of a manual.";

git -C "${project_dir}" worktree remove --force "${worktree}";
worktree_made="no";

# The tag is the same object as before the build.
if [ "${rebuild}" = "yes" ]; then
    [ "$(git -C "${project_dir}" rev-parse "refs/tags/v${version}")" = \
      "${tag_object}" ] ||
        die "the tag v${version} is not the object that it was: this must" \
            "not happen.";
fi

finished="yes";

echo "tag:      v${version}";
echo "commit:   ${rev}";
echo "tarball:  ${tarball}";
echo "checksum: ${sumfile}";
echo "SHA-256:  $(cut -d' ' -f1 "${sumfile}")";
echo "manual PDF files in the tarball:";
echo "${pdf_list}" | sed -e 's/^/  /';

if [ "${rebuild}" = "yes" ]; then
    echo "The tag v${version} was not changed.  The bytes of this tarball";
    echo "differ from a release made on another machine, so the checksum";
    echo "that counts is the one of the file that was published.";
else
    echo "Next, by hand (the tool pushes nothing):";
    echo "  git push github v${version}";
    echo "  then make a release on the page of the repository on GitHub from";
    echo "  the tag v${version}, with the two files above attached.";
fi
