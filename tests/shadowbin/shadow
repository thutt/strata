#
# A guard, not an opener.  The tests put the directory of this script at the
# front of PATH, with the names xdg-open, gio and open linked to it, so that
# a test can never start a real program that opens a PDF (a window on the
# display of the person who runs the tests).  It never starts anything.
#
#   SHADOW_ALLOW=1  the test expects the call: the call is recorded in the
#                   file FAKEOPEN_LOG in the form of tests/fakeopen.sh, and
#                   the status is 0.
#   otherwise       the call is recorded in the file SHADOW_LOG, and the
#                   status is 1.
#
set -o pipefail;
set -o nounset;
set -o errexit;

name="$(basename "${0}")"
args=""
last=""

for a in "${@}"; do
    args="${args}|${a}"
    last="${a}"
done

if [ "${SHADOW_ALLOW:-0}" = "1" ]; then
    extra=""

    if [ -f "${last}" ]; then
        extra=" size=$(stat -c %s "${last}") magic=$(head -c 4 "${last}")"
    fi

    echo "${name}${args}${extra}" >> "${FAKEOPEN_LOG:-/dev/null}"
    exit 0
fi

echo "${name}${args}" >> "${SHADOW_LOG:-/dev/null}"
echo "${name}: a test must not start a program that opens a PDF" >&2
exit 1
